APP_NAME="Movie Helper"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-database-password
# require pour Supabase ; en Postgres local sans TLS, mettre prefer.
DB_SSLMODE=require
# true uniquement quand DB_HOST pointe sur une vraie instance Supabase
# (applique alors les FK auth.users, la RLS et les policies storage).
# En dev/CI Postgres local : false.
DB_IS_SUPABASE=false

# Base dediee aux tests (connexion pgsql_testing). Defaut : Postgres local.
DB_TEST_DATABASE=movie_helper_test
DB_TEST_SSLMODE=prefer

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_STORAGE_FDX_BUCKET=fdx-files
SUPABASE_STORAGE_EXPORTS_BUCKET=exports

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4000
ANTHROPIC_TIMEOUT_SECONDS=120

QUEUE_CONNECTION=database
AI_QUEUE_NAME=ai
AI_QUEUE_MAX_WORKERS=2
AI_JOB_TRIES=2
AI_JOB_BACKOFF_SECONDS=30

CACHE_STORE=database
LOG_CHANNEL=stack
LOG_LEVEL=debug
