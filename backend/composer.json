{
  "name": "movie-helper",
  "description": "Movie Helper - Laravel Backend",
  "keywords": ["laravel", "screenplay", "breakdown"],
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "laravel/tinker": "^2.8",
    "laravel/pint": "^1.13",
    "laravel-zero/foundation": "^8.16"
  },
  "require-dev": {
    "laravel/pint": "^1.13",
    "pestphp/pest": "^2.33",
    "phpstan/phpstan": "^1.10",
    "laravel/sail": "^1.26"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
